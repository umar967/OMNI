# Copy to Backend/.env. Never put credentials in the frontend.
GEMINI_API_KEY=
# Model selected by the original program; choose one available to your key.
GEMINI_MODEL=gemini-3.8-flash
# Request timeouts and total attempts (including the first request).
GEMINI_ACTION_TIMEOUT_SECONDS=30
GEMINI_REVIEW_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=2
# Live sessions may use Ollama instead; screenshot reviews still require Gemini.
OMNI_MODEL_PROVIDER=gemini
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_ATTEMPTS=1
